{
    "layer": "top",
    "position": "top",  
    "spacing": 6,
    "margin-top": 8,
    "margin-left": 8,
    "margin-right": 8,
    "margin-bottom": 0,
    "height": 38,
    "modules-left": ["hyprland/window"],
    "modules-center": ["ext/workspaces"],
    "modules-right": ["tray", "pulseaudio", "network", "custom/memory", "custom/compute", "clock"],
    "ext/workspaces": {
        "format": "{name}",
        "sort-by-id": false,
        "sort-by-name": true,
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'"
    },
    "hyprland/window": {
        "format": "\uf105 {title}",
        "separate-outputs": true
    },
    "tray": {
        "icon-size": 21,
        "spacing": 10
    },
    "clock": {
        "interval": 1,
        "format": "\uf017 {:%H:%M:%S}",
        "format-alt": "\uf133 {:%Y-%m-%d %H:%M:%S}",
        "tooltip-format": "{calendar}",
        "calendar": {
            "mode"          : "month",
            "mode-mon-col"  : 3,
            "weeks-pos"     : "right",
            "on-scroll"     : 1,
            "format": {
                "months":     "<span color='#ffead3'>{}</span>",
                "days":       "<span color='#ecc6d9'>{}</span>",
                "weeks":      "<span color='#99ffdd'>W{}</span>",
                "weekdays":   "<span color='#ffcc66'>{}</span>",
                "today":      "<span color='#ff6699'><u>{}</u></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-click-forward": "tz_up",
            "on-click-backward": "tz_down",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },
    "custom/compute": {
        "exec": "sh $HOME/.config/waybar/compute-view.sh",
        "return-type": "json",
        "format": "{text}",
        "interval": 1,
        "on-click": "sh $HOME/.config/waybar/compute-view.sh toggle",
        "tooltip": true
    },
    "custom/memory": {
        "exec": "sh $HOME/.config/waybar/memory-view.sh",
        "return-type": "json",
        "format": "{text}",
        "interval": 1,
        "on-click": "sh $HOME/.config/waybar/memory-view.sh toggle",
        "tooltip": true
    },
    "network": {
        "interval": 1,
        "format-wifi": "\uf1eb {essid} ({signalStrength}%)",
        "format-ethernet": "\uef09 {ifname}",
        "format-linked": "\ueb32 No IP ({ifname})",
        "format-disconnected": "\uf071 Disconnected",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}, Gateway: {gwaddr}",
        "format-alt": "\uef09 {ipaddr}/{cidr}"
    },
    "pulseaudio": {
        "scroll-step": 5,
        "format": "{icon} {volume:2}%",
        "format-muted": "\ueee8",
        "format-bluetooth": "{icon}\uf294 {volume}%",
        "format-bluetooth-muted": "\ueee8 {icon}\uf294",
        "format-icons": {
            "default": ["\uf026", "\uf027", "\uf028"]
        },
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    }
}
