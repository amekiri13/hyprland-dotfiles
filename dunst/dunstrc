[global]
    width = 360
    height = (0, 260)
    origin = top-right
    offset = (16, 52)
    font = AtkynsonMono Nerd Font 11
    corner_radius = 14
    frame_width = 1
    frame_color = "#93aeff"
    gap_size = 8
    padding = 12
    horizontal_padding = 16
    text_icon_padding = 12
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    progress_bar = true
    progress_bar_corner_radius = 5

[urgency_low]
    background = "#0c1434d4"
    foreground = "#d7e1ff"
    timeout = 10

[urgency_normal]
    background = "#0c1434d4"
    foreground = "#eaf0ff"
    timeout = 10
    override_pause_level = 30

[urgency_critical]
    background = "#301b3fe6"
    foreground = "#eaf0ff"
    frame_color = "#ff9fac"
    timeout = 0
    override_pause_level = 60

# OBS 运行时由监视脚本启用：通知只进历史，不弹出或排队。
[obs_quiet]
    skip_display = true
    history_ignore = false
